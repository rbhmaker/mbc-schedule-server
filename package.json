const express = require('express');
const cors = require('cors');
const app = express();

app.use(cors());
app.use(express.json());

// 메모리 임시 저장소 (필요시 DB 연동)
let schedules = [
    {
        id: 1,
        title: "MBC 상암 본사",
        date: "2026-03-01",
        category: "본사",
        address: "서울특별시 마포구 성암로 267",
        lat: 37.5802,
        lng: 126.8903,
        reporter: "MBC",
        equipment: "기본",
        newsUrl: "",
        photoUrl: "",
        desc: "MBC 뉴스센터 메인 본사입니다.",
        isMainHQ: true,
        regionName: "마포구"
    },
    {
        id: 2,
        title: "의정부 경찰서 취재",
        date: "2026-03-15",
        category: "사회부",
        address: "경기도 의정부시 가능동",
        lat: 37.7381,
        lng: 127.0337,
        reporter: "김취재 기자",
        equipment: "ENG 카메라",
        newsUrl: "https://imnews.imbc.com",
        photoUrl: "",
        desc: "현장 사건사고 취재 일정입니다.",
        isMainHQ: false,
        regionName: "의정부시"
    }
];

// 주소에서 서울은 '구', 지방/경기는 '시/군'을 추출하는 헬퍼 함수
function parseRegion(address) {
    if (!address) return "전국";
    if (address.includes("서울")) {
        const m = address.match(/([가-힣]+구)/);
        if (m) return m[1];
    }
    const m = address.match(/([가-힣]+시|[가-힣]+군)/);
    if (m) return m[1];
    return address.split(" ")[0];
}

// 1. 전체 위치 가벼운 목록 조회
app.get('/api/locations/light', (req, res) => {
    res.json(schedules);
});

// 2. 단일 일정 상세 조회
app.get('/api/schedules/detail', (req, res) => {
    const id = parseInt(req.query.id);
    const item = schedules.filter(s => s.id === id);
    res.json(item);
});

// 3. 신규 일정 추가
app.post('/api/schedules', (req, res) => {
    const newSchedule = {
        id: Date.now(),
        ...req.body,
        regionName: parseRegion(req.body.address),
        isMainHQ: false
    };
    schedules.push(newSchedule);
    res.status(201).json({ success: true, data: newSchedule });
});

const PORT = process.env.PORT || 3000;
app.listen(PORT, () => {
    console.log(`Server running on port ${PORT}`);
});
